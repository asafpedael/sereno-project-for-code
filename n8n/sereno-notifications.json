    {
      "id": "5e7e0000-0000-4000-8000-000000000036",
      "name": "Allowlist check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        350
      ],
      "parameters": {
        "jsCode": "// Only test inboxes may receive email. Put the real test addresses here in n8n (not in the repo).\nconst ALLOWLIST = ['test-inbox@example.com', 'manager-inbox@example.com'];\n\nreturn $input.all().map((item) => {\n  const to = String(item.json.to || '').trim().toLowerCase();\n  return { json: { ...item.json, to, allowed: ALLOWLIST.includes(to) } };\n});"
      }
    },
