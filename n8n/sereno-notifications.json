      "parameters": {
        "jsCode": "// Render email: the single Sereno email template (DESIGN \"Emails\", decided 18.11.2026).\n// Input items come from the \"Set <type>\" nodes: to, type, subject, preheader, heading, intro,\n// rows [{label, value}], highlight_label, highlight_value, paragraph, closing.\n// Output: to, type, subject, html (designed) and text (plain-text version of the same content).\n// Every value is HTML-escaped here: customer names and the AI paragraph are untrusted.\n// All styles are inline. The fonts are the site's own (Milestone 12: Gilda Display, Montserrat),\n// loaded from the live site by email apps that allow web fonts (e.g. Apple Mail); Gmail ignores\n// them and shows the fallbacks (Georgia for headings, Arial for text).\n\nconst C = {\n  deep: '#0F1620', navy: '#22344A', cream: '#F6F1E8', paper: '#FBF8F2',\n  gold: '#CF9A53', soft: '#4A5868', onDarkSoft: '#B9C2CD', rule: '#C7C7C5',\n};\nconst SERIF = \"'Gilda Display', Georgia, 'Times New Roman', serif\";\nconst SANS = 'Montserrat, Arial, Helvetica, sans-serif';\nconst FONT_BASE = 'https://sereno-olive-mu.vercel.app/assets/fonts/';\nconst FONT_STYLE = `<style>\n@font-face { font-family: 'Gilda Display'; font-style: normal; font-weight: 400; src: url('${FONT_BASE}gilda-display-latin.woff2') format('woff2'); }\n@font-face { font-family: 'Montserrat'; font-style: normal; font-weight: 400 700; src: url('${FONT_BASE}montserrat-latin.woff2') format('woff2'); }\n</style>`;\n\nconst esc = (v) => String(v === undefined || v === null ? '' : v)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst multiline = (v) => esc(v).replace(/\\r?\\n/g, '<br>');\nconst present = (v) => v !== undefined && v !== null && String(v).trim() !== '';\n\nfunction renderHtml(m, rows) {\n  const preheader = present(m.preheader)\n    ? `<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:${C.cream};\">${esc(m.preheader)}</div>`\n    : '';\n\n  const highlight = present(m.highlight_value) ? `\n          <tr><td style=\"padding:8px 32px 0;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:${C.navy};border-radius:2px;\">\n              <tr><td style=\"padding:18px 24px;\">\n                <div style=\"font-family:${SANS};font-size:14px;font-weight:bold;color:${C.onDarkSoft};\">${esc(m.highlight_label)}</div>\n                <div style=\"font-family:${SERIF};font-size:30px;line-height:1.2;color:${C.gold};padding-top:4px;\">${esc(m.highlight_value)}</div>\n              </td></tr>\n            </table>\n          </td></tr>` : '';\n\n  const rowHtml = rows.map((r, i) => `\n                <tr>\n                  <td style=\"padding:10px 16px;${i ? `border-top:1px solid ${C.rule};` : ''}font-family:${SANS};font-size:13px;color:${C.soft};width:38%;vertical-align:top;\">${esc(r.label)}</td>\n                  <td style=\"padding:10px 16px;${i ? `border-top:1px solid ${C.rule};` : ''}font-family:${SANS};font-size:15px;font-weight:bold;color:${C.navy};vertical-align:top;\">${multiline(r.value)}</td>\n                </tr>`).join('');\n  const details = rows.length ? `\n          <tr><td style=\"padding:20px 32px 0;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:${C.paper};border:1px solid ${C.rule};border-radius:2px;\">${rowHtml}\n            </table>\n          </td></tr>` : '';\n\n  const paragraph = present(m.paragraph) ? `\n          <tr><td style=\"padding:20px 32px 0;font-family:${SANS};font-size:16px;line-height:1.6;color:${C.navy};\">${multiline(m.paragraph)}</td></tr>` : '';\n  const closing = present(m.closing) ? `\n          <tr><td style=\"padding:20px 32px 0;font-family:${SANS};font-size:15px;line-height:1.6;color:${C.soft};\">${multiline(m.closing)}</td></tr>` : '';\n\n  return `<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>${esc(m.subject)}</title>\n${FONT_STYLE}\n</head>\n<body style=\"margin:0;padding:0;background:${C.cream};\">\n${preheader}\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:${C.cream};\">\n  <tr><td align=\"center\" style=\"padding:24px 12px;\">\n    <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background:${C.cream};\">\n      <tr><td style=\"background:${C.deep};padding:20px 32px;font-family:${SERIF};font-size:26px;font-weight:normal;color:${C.cream};\">Sereno</td></tr>\n      <tr><td style=\"padding:32px 32px 0;\">\n        <div style=\"width:56px;height:2px;background:${C.gold};font-size:0;line-height:0;\">&nbsp;</div>\n        <h1 style=\"margin:16px 0 0;font-family:${SERIF};font-size:28px;line-height:1.2;font-weight:normal;color:${C.navy};\">${esc(m.heading)}</h1>\n      </td></tr>\n      <tr><td style=\"padding:12px 32px 0;font-family:${SANS};font-size:16px;line-height:1.6;color:${C.navy};\">${multiline(m.intro)}</td></tr>${highlight}${details}${paragraph}${closing}\n      <tr><td style=\"padding:32px 32px 28px;font-family:${SANS};font-size:13px;line-height:1.5;color:${C.soft};\">Sereno · quality. speed. comfort.</td></tr>\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>`;\n}\n\nfunction renderText(m, rows) {\n  const lines = [String(m.heading || '').trim(), '', String(m.intro || '').trim()];\n  if (present(m.highlight_value)) lines.push('', `${m.highlight_label}: ${m.highlight_value}`);\n  if (rows.length) lines.push('', ...rows.map((r) => `${r.label}: ${r.value}`));\n  if (present(m.paragraph)) lines.push('', String(m.paragraph).trim());\n  if (present(m.closing)) lines.push('', String(m.closing).trim());\n  lines.push('', 'Sereno · quality. speed. comfort.');\n  return lines.join('\\n');\n}\n\nreturn $input.all().map((item) => {\n  const m = item.json;\n  // Types without designed content yet (M5) keep their plain text inside the same layout.\n  const content = present(m.heading) ? m : { ...m, heading: m.subject, intro: m.text };\n  const rows = (Array.isArray(content.rows) ? content.rows : []).filter((r) => r && present(r.value));\n  return {\n    json: {\n      to: m.to,\n      type: m.type,\n      subject: m.subject,\n      html: renderHtml(content, rows),\n      text: present(m.heading) ? renderText(content, rows) : String(m.text || ''),\n    },\n  };\n});\n"
      }
    },
    {
